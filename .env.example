# Backend
BACKEND_PORT=3001
ASSISTANT_WORKDIR=/Users/yourname
# PDFs and other generated artifacts land here.
# Relative paths are resolved from the repo root.
ASSISTANT_OUTPUT_DIR=./output

# LLM
LLM_PROVIDER=openai  # openai | anthropic | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com

# Groq (often has a free tier) — Meta/Llama models
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local LLM (no API key) via Ollama
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Sarvam
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_LANG=en-IN
SARVAM_TTS_SPEAKER=

# Frontend
BACKEND_BASE_URL=http://127.0.0.1:3001
ELECTRON_SHORTCUT=CommandOrControl+Space
